# Copie este arquivo para .env (que fica fora do Git) e defina a senha.
#
# Senha do usuário "sa" do SQL Server local (docker-compose).
# Regras do SQL Server: no mínimo 8 caracteres, com maiúsculas, minúsculas, números e símbolos.
# Não use ";" nem aspas: a senha entra na connection string da API.
SQL_SA_PASSWORD=
