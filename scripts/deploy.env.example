# Configuração do scripts/deploy.sh
#
# 1. Copie este arquivo:   cp scripts/deploy.env.example scripts/deploy.env
# 2. Preencha os valores no scripts/deploy.env (ele fica fora do Git).
# 3. Rode:                 ./scripts/deploy.sh
#
# Todos os campos são opcionais: o que ficar vazio usa o padrão indicado.

# Assinatura da Azure (nome ou id). Vazio: usa a assinatura atual do Azure CLI.
# Para listar as suas: az account list -o table
ASSINATURA=""

# Região dos recursos. Padrão: chilecentral
REGIAO="chilecentral"

# Nome do Resource Group. Padrão: rg-dindinbuddies
GRUPO="rg-dindinbuddies"

# Sufixo dos nomes globais (servidor SQL e Web Apps): 3 a 10 letras minúsculas ou números.
# Vazio: o script gera um aleatório e grava aqui, para as próximas execuções
# atualizarem os mesmos recursos.
SUFIXO=""

# Usuário administrador do Azure SQL. Padrão: dindinadmin
# (não pode ser admin, administrator, sa, root, guest, public nem dbo)
SQL_ADMIN_USER="dindinadmin"

# Senha do administrador do Azure SQL. Vazio: o script pede na execução.
# Regras: 8+ caracteres e 3 destes grupos: maiúsculas, minúsculas, números, símbolos.
# Não use ";" nem aspas (ela entra na connection string da API).
SQL_ADMIN_PASSWORD=""
