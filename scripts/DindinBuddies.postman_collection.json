    {
      "name": "1. Clientes",
      "item": [
        {
          "name": "Criar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF e e-mail únicos a cada execução (a API não aceita duplicados).",
                  "const cpf = Array.from({ length: 11 }, () => Math.floor(Math.random() * 10)).join('');",
                  "pm.collectionVariables.set('cpf', cpf);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clienteId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"cpf\": \"{{cpf}}\",\n  \"email\": \"ana.{{cpf}}@email.com\",\n  \"telefone\": \"11 99999-0000\",\n  \"dataNascimento\": \"1990-05-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar clientes (busca por nome ou CPF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
